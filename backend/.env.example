APP_ENV=local

# Retrieval backend selection: sqlite or postgres
RETRIEVAL_BACKEND=sqlite
RETRIEVAL_DB_PATH=backend/data/retrieval.sqlite3
RETRIEVAL_POSTGRES_DSN=postgresql://credit_user:credit_pass@localhost:5432/credit_assistant
RETRIEVAL_EMBEDDING_MODEL=LocalHashEmbeddingProvider

# Model backend selection: local, openai, or remote
MODEL_BACKEND=local
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
OPENAI_BASE_URL=
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_NAME=
