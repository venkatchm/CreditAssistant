APP_ENV=local

# --- Retrieval Backend ---
# sqlite (default, zero-setup) or postgres (production with pgvector)
RETRIEVAL_BACKEND=sqlite
RETRIEVAL_DB_PATH=backend/data/retrieval.sqlite3
RETRIEVAL_POSTGRES_DSN=postgresql://credit_user:credit_pass@localhost:5432/credit_assistant
RETRIEVAL_EMBEDDING_MODEL=LocalHashEmbeddingProvider

# --- Embedding Provider ---
# hash (default, dev-only) or openai (production, uses text-embedding-3-small)
EMBEDDING_PROVIDER=hash
EMBEDDING_DIMENSIONS=1536
EMBEDDING_BATCH_SIZE=100

# --- Credit Data Backend ---
# json (default, local files) or postgres (Supabase)
CREDIT_DATA_BACKEND=json

# --- Ingestion Settings ---
INGESTION_CHUNK_MAX_CHARS=800
INGESTION_CHUNK_OVERLAP=1

# --- LLM Model Backend ---
# local (rule-based), openai, remote, or anthropic
MODEL_BACKEND=local
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
OPENAI_BASE_URL=
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_NAME=

# Anthropic Claude with prompt caching (recommended for production)
# MODEL_BACKEND=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# --- Production Configuration Example ---
# APP_ENV=production
# RETRIEVAL_BACKEND=postgres
# RETRIEVAL_POSTGRES_DSN=postgresql://user:pass@host:5432/credit_assistant
# RETRIEVAL_EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_PROVIDER=openai
# CREDIT_DATA_BACKEND=postgres
# MODEL_BACKEND=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
